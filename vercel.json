{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "circuits.html",
      "use": "@vercel/static"
    },
    {
      "src": "champions.html",
      "use": "@vercel/static"
    },
    {
      "src": "main.js",
      "use": "@vercel/static"
    },
    {
      "src": "resources/*",
      "use": "@vercel/static"
    },
    {
      "src": "resources/champion-hamilton.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/champion-leclerc.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/champion-schumacher.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/champion-verstappen.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/circuit-aerial.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/f1-racing-battle.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/hamilton-action.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/hero-f1-car.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/silverstone-circuit.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/Spa-Francorchamps-circuit.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "resources/verstappen-action.jpg",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/circuits",
      "destination": "/circuits.html"
    },
    {
      "source": "/champions",
      "destination": "/champions.html"
    }
  ],
  "headers": [
    {
      "source": "/resources/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/main.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/resources/(.*\\.jpg)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    },
    {
      "source": "/resources/(.*\\.jpeg)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    },
    {
      "source": "/resources/(.*\\.png)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "installCommand": "echo 'No dependencies to install'",
  "buildCommand": "echo 'No build step required'"
}
