{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "circuits.html",
      "use": "@vercel/static"
    },
    {
      "src": "champions.html",
      "use": "@vercel/static"
    },
    {
      "src": "main.js",
      "use": "@vercel/static"
    },
    {
      "src": "resources/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/circuits",
      "destination": "/circuits.html"
    },
    {
      "source": "/champions",
      "destination": "/champions.html"
    }
  ],
  "headers": [
    {
      "source": "/resources/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/main.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "installCommand": "echo 'No dependencies to install'",
  "buildCommand": "echo 'No build step required'"
}
