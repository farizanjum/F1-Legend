{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "circuits.html",
      "use": "@vercel/static"
    },
    {
      "src": "champions.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/circuits",
      "destination": "/circuits.html"
    },
    {
      "source": "/champions",
      "destination": "/champions.html"
    }
  ],
  "headers": [
    {
      "source": "/resources/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "installCommand": "echo 'No dependencies to install'",
  "buildCommand": "echo 'No build step required'"
}
